# Kopiera till .env (en server per dator) eller till .env.3001 och .env.3002
# (två servrar på samma dator). Se "Starta servrarna" i README.

# Porten servern lyssnar på
PORT=3001

# Unikt id för noden, hamnar i varje block i kedjan
NODE_ID=node-3001

# Valfritt: nodens egen adress i peer:hello. Vid olika datorer: ange egen LAN-IP.
# NODE_URL=http://192.168.1.10:3001

# Adress till den andra servern
PEER_URL=http://localhost:3002

# Hemlighet för peer-anslutningar på /peers. Samma slumpade värde på båda
# instanserna. Utan den avvisas alla peers och ingen synk sker mellan noderna.
# Lägg den aldrig i en VITE_-variabel och checka aldrig in riktiga värden.
PEER_SECRET=

# Var frontend körs (Vite), för CORS med cookies
CLIENT_ORIGIN=http://localhost:5173

# SQLite-filen, relativt server/. Båda instanserna på samma dator ska peka på samma fil.
DB_PATH=../data/journal.db

# Hemlighet för JWT-cookien. Samma värde på båda instanserna.
JWT_SECRET=change-me-locally
